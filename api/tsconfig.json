{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "noEmit": true,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["server.ts"]
}
